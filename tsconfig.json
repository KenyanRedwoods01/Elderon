{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@elderonai/types": ["./packages/types/src"],
      "@elderonai/utils": ["./packages/utils/src"],
      "@elderonai/ui": ["./packages/ui/src"],
      "@elderonai/auth": ["./packages/auth/src"],
      "@elderonai/database": ["./packages/database/src"],
      "@elderonai/config": ["./packages/config/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next"]
}
